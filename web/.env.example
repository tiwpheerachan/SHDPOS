# =====================================================================
# SHD POS — ตัวแปรสภาพแวดล้อม
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง
#
# ถ้าไม่ตั้งสองค่าแรก ระบบจะรันใน "โหมดสาธิต" (ข้อมูลตัวอย่างในเครื่อง)
# =====================================================================

# Supabase (หน้า Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service role key — ใช้เฉพาะงานฝั่ง server (import สินค้า, cron) ห้ามใส่ใน NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Print Bridge บนเครื่อง POS (แก้ได้จากหน้าตั้งค่าในแอปด้วย)
NEXT_PUBLIC_PRINT_BRIDGE_URL=http://127.0.0.1:9110

# ข้อมูลบริษัทสำหรับหัวใบกำกับภาษี
NEXT_PUBLIC_COMPANY_NAME=บริษัท เอส เอช ดี เทคโนโลยี จำกัด
NEXT_PUBLIC_COMPANY_TAX_ID=0000000000000
