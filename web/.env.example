# =====================================================================
# SHD POS — ตัวแปรสภาพแวดล้อม
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง
#
# ถ้าไม่ตั้งสองค่าแรก ระบบจะรันใน "โหมดสาธิต" (ข้อมูลตัวอย่างในเครื่อง)
# =====================================================================

# Supabase (หน้า Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service role key — ใช้เฉพาะงานฝั่ง server (import สินค้า, cron) ห้ามใส่ใน NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Print Bridge บนเครื่อง POS (แก้ได้จากหน้าตั้งค่าในแอปด้วย)
NEXT_PUBLIC_PRINT_BRIDGE_URL=http://127.0.0.1:9110

# ข้อมูลบริษัทสำหรับหัวใบกำกับภาษี
NEXT_PUBLIC_COMPANY_NAME=บริษัท เอส เอช ดี เทคโนโลยี จำกัด
NEXT_PUBLIC_COMPANY_TAX_ID=0000000000000

# OneWarehouse /v1 reads (server-side only)
ONEWAREHOUSE_BASE=https://onestock-1011275911158.asia-southeast1.run.app
ONEWAREHOUSE_SERVICE_TOKEN=   # secret — out-of-band, never commit
ONEWAREHOUSE_SUB=            # numeric One Login sub

# Explicit source environment; never reuse UAT warehouse mappings in production.
ONEWAREHOUSE_ENV=uat
ONEWAREHOUSE_SOURCE_ID=onewarehouse

# OW read-sync worker: private random secret >=32 characters; same value on web and worker.
# Run from web/: npm run ow:worker (managed service in deployment).
OW_SYNC_CRON_SECRET=
OW_SYNC_WORKER_ORIGIN=http://localhost:3100

# ── แผนที่ยอดขาย "พิกัดจริง" (/admin) — Google Maps ──
# ใส่ Google Maps API key (เปิดใช้ "Maps JavaScript API" + Billing + จำกัด HTTP referrer โดเมนจริง+localhost)
# มีค่า = แผนที่ Google จริง (ซูม/ลาก/ถนน) · ว่างไว้ = ใช้โครงแผนที่เวกเตอร์
# local: ใส่ในไฟล์ web/.env.local  ·  deploy(Render): Settings → Environment → Add
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
